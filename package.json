{
  "name": "benpocket",
  "version": "0.0.7",
  "description": "benpocket, a personal multi-purpose desktop toolkit (Swiss Army knife) combining small tools.",
  "main": "./out/main/index.js",
  "author": "https://benpocket.com",
  "homepage": "https://benpocket.com",
  "desktopName": "benpocket.desktop",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "patch-package && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:native:macos": "cd native/macos-recorder && swift build -c release && cd ../.. && node scripts/package-native-helper.mjs macos",
    "build:native:windows": "cmake -S native/windows-recorder -B native/windows-recorder/build && cmake --build native/windows-recorder/build --config Release && node scripts/package-native-helper.mjs windows",
    "build:native:linux": "cmake -S native/linux-recorder -B native/linux-recorder/build && cmake --build native/linux-recorder/build && node scripts/package-native-helper.mjs linux",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "release:mac": "electron-vite build && electron-builder --mac --publish always",
    "release:linux": "electron-vite build && electron-builder --linux --publish always",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/lib-storage": "^3.1088.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@homebridge/dbus-native": "^0.7.7",
    "@kubernetes/client-node": "^1.4.0",
    "cloudflare": "^7.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^5.2.3",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.3",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.21.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fix-webm-duration/fix": "^1.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "@types/gif.js": "^0.2.5",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cnfast": "^0.0.8",
    "echarts": "^6.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gif.js": "^0.2.0",
    "knip": "^6.26.0",
    "lucide-react": "^1.23.0",
    "mediabunny": "^1.50.9",
    "motion": "^12.43.0",
    "patch-package": "^8.0.1",
    "pixi.js": "^8.19.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10",
    "web-demuxer": "^4.0.0",
    "zustand": "^5.0.14"
  }
}
