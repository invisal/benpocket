{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "@playwright/test"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@screen-recorder/*": ["src/renderer/tools/screen-recorder/*"]
    }
  },
  "include": ["e2e/**/*", "playwright.config.ts", "src/renderer/src/env.d.ts"]
}
