{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // electron-vite plugin auto-detects main/preload from electron.vite.config.ts, but doesn't
  // resolve the renderer HTML entries' `/src/main.tsx`-style script paths against each HTML
  // file's directory, so those need to be listed explicitly (see src/renderer/*.html).
  "entry": [
    "src/preload/index.d.ts",
    "src/renderer/src/main.tsx",
    "src/renderer/recorder-toolbar.tsx",
    "src/renderer/region-select.ts",
    "src/renderer/source-picker-overlay.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  // System binaries invoked via spawn/execFile — not npm packages.
  // xclip: Linux X11 clipboard helper.
  // xcrun/osascript: macOS Xcode CLI tools / AppleScript, used for Simulator detection and window bounds.
  // kubectl: Kubernetes CLI, spawned by the kuberneter tool.
  // swift/cmake: build native/macos-recorder and native/windows-recorder's
  // standalone recording helper subprocesses (see recording-helper.ts).
  "ignoreBinaries": ["xclip", "xcrun", "osascript", "kubectl", "helm", "swift", "cmake"],
  // Pulled in via @import 'tailwindcss' in main.css and @tailwindcss/vite plugin
  "ignoreDependencies": ["tailwindcss"],
  // Skip exports that are only referenced within the same file
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // Lazy tools: export function X + export default X for loadComponent: () => import('...')
    "src/renderer/tools/**": ["duplicates"]
  }
}
